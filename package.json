{
  "name": "flower-maker",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "client",
      "api",
      "agents"
    ],
    "catalog": {
      "@types/bun": "^1.4.2",
      "ai": "^7.0.107",
      "typescript": "^7.0.2",
      "zod": "^4.6.5",
      "spacetimedb": "^2.10.1"
    }
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "mkdir -p .logs && trap 'kill 0' EXIT && bun run dev:spacetime > .logs/spacetime.log 2>&1 & bun run dev:api > .logs/api.log 2>&1 & bun run dev:publish-local > .logs/publish.log 2>&1 & bun run dev:client",
    "dev:publish-local": "bun scripts/publish.ts --wait-for-local",
    "dev:client": "bun run --filter client dev",
    "dev:api": "bun --watch api/index.ts",
    "dev:spacetime": "spacetime start --listen-addr 0.0.0.0:9300",
    "dev:agent": "bun run --filter flower-agents agent",
    "db:publish": "bun scripts/publish.ts --server maincloud",
    "db:publish:local": "bun scripts/publish.ts",
    "db:publish:clear": "bun scripts/publish.ts --server maincloud --clear",
    "db:generate": "bun scripts/generate.ts",
    "db:deploy": "bun run db:publish && bun run db:generate",
    "db:logs": "spacetime logs flower-picker --server maincloud",
    "build": "bun run --filter '*' build",
    "check": "bun run --parallel check:type lint check:format",
    "check:type": "bun run --filter '*' check",
    "lint": "bunx oxlint --type-aware",
    "lint:fix": "bunx oxlint --type-aware --fix",
    "fmt": "bunx oxfmt .",
    "check:format": "bunx oxfmt --check .",
    "outdated": "bun outdated --filter '*'",
    "update": "bun update --filter '*'"
  },
  "devDependencies": {
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002"
  }
}
